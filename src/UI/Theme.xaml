<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== palette (from the Choppy concept) ===== -->
    <Color x:Key="C.WinTop">#FF232931</Color>
    <Color x:Key="C.WinBottom">#FF1B1F25</Color>
    <SolidColorBrush x:Key="B.WinBorder" Color="#FF333A43"/>
    <SolidColorBrush x:Key="B.Card" Color="#FF171A1F"/>
    <SolidColorBrush x:Key="B.CardBorder" Color="#FF262B33"/>
    <SolidColorBrush x:Key="B.Text" Color="#FFF1F3F5"/>
    <SolidColorBrush x:Key="B.Text2" Color="#FFDDE1E6"/>
    <SolidColorBrush x:Key="B.Dim" Color="#FF9AA2AD"/>
    <SolidColorBrush x:Key="B.Label" Color="#FF8A929E"/>
    <SolidColorBrush x:Key="B.Faint" Color="#FF6B737E"/>
    <SolidColorBrush x:Key="B.Accent" Color="#FF0E72E6"/>
    <SolidColorBrush x:Key="B.AccentHover" Color="#FF1C80F2"/>
    <SolidColorBrush x:Key="B.AccentText" Color="#FF5CB8FF"/>
    <SolidColorBrush x:Key="B.Track" Color="#FF2A2F37"/>
    <SolidColorBrush x:Key="B.Good" Color="#FF4CC38A"/>
    <SolidColorBrush x:Key="B.Warn" Color="#FFE8B04B"/>
    <SolidColorBrush x:Key="B.Bad" Color="#FFF07A72"/>
    <!-- speed color code: right now = the graph's blue, average = lavender (also the dashed line in the graph) -->
    <SolidColorBrush x:Key="B.NowSpeed" Color="#FF5AC8FA"/>
    <SolidColorBrush x:Key="B.AvgSpeed" Color="#FFC4A7FF"/>
    <!-- sizes: done = green, total = peach; times (elapsed, remaining) = amber -->
    <SolidColorBrush x:Key="B.SizeDone" Color="#FF7DD3A0"/>
    <SolidColorBrush x:Key="B.SizeTotal" Color="#FFF0B68C"/>
    <SolidColorBrush x:Key="B.Time" Color="#FFF2C46D"/>
    <!-- quick toggles: green dot = on, red dot = off -->
    <SolidColorBrush x:Key="B.On" Color="#FF3DD27A"/>
    <SolidColorBrush x:Key="B.Off" Color="#FFF0645F"/>
    <SolidColorBrush x:Key="B.Sep" Color="#FF2E343C"/>
    <SolidColorBrush x:Key="B.Link" Color="#FF6CC4F5"/>
    <LinearGradientBrush x:Key="B.Progress" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF1A7FE6" Offset="0"/>
        <GradientStop Color="#FF5AC8FA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Window" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource C.WinTop}" Offset="0"/>
        <GradientStop Color="{StaticResource C.WinBottom}" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== text ===== -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Label}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    </Style>

    <!-- section caps: FROM, TO, SPEED, CURRENT FILE... -->
    <Style x:Key="T.Cap" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Label}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    </Style>

    <!-- ===== cards ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="16,13,16,14"/>
    </Style>

    <!-- ===== buttons ===== -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="#FF262B32"/>
        <Setter Property="BorderBrush" Value="#FF383E47"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="MinWidth" Value="74"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2F353D"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF454C56"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF22262C"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF5CB8FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.Accent}"/>
        <Setter Property="BorderBrush" Value="#FF2A86EE"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource B.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF0B62C6"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FFBFE3FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Cancel" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="#FF23272D"/>
        <Setter Property="BorderBrush" Value="#FF3A4048"/>
        <Setter Property="Foreground" Value="#FFF4B8B3"/>
    </Style>

    <!-- title bar buttons -->
    <Style x:Key="Btn.Title" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="#FFC9CED6"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF2C323A"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF262B32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.TitleClose" TargetType="Button" BasedOn="{StaticResource Btn.Title}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFC42B1C"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FFA3271B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- flat clickable text -->
    <Style x:Key="Btn.Link" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="5" Padding="6,3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF262B32"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== toggle switch ===== -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#FF3A3F47"
                                BorderBrush="#FF4A515C" BorderThickness="1" VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#FFF1F3F5" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="#FF2A86EE"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="#FF6B737E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== check box (conflict "apply to all") ===== -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="#FF59616C" Background="#FF1F2329">
                            <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="{StaticResource F.Icons}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== pill choices ===== -->
    <Style x:Key="Pill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="14" Padding="12,5" Background="#FF22262C" BorderBrush="#FF353B44" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF59616C"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#FF15324F"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2A79C8"/>
                            <Setter Property="Foreground" Value="#FF8ACDFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== segmented choice (settings): the chosen one is filled ===== -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,6"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" CornerRadius="6" Padding="12,6,12,7" Background="#FF262B32" BorderBrush="#FF383E47" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF59616C"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2A86EE"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== quick toggle (copy window): a dot that is green when on, red when off ===== -->
    <Style x:Key="QuickDot" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text2}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource B.Off}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource B.On}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Quick" TargetType="CheckBox" BasedOn="{StaticResource QuickDot}">
        <Setter Property="Margin" Value="0,0,7,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="b" CornerRadius="16" Height="32" Padding="11,0,13,0" Background="#FF22262C" BorderBrush="#FF383E47" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource B.Off}" VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Fill" Value="{StaticResource B.On}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF59616C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuickPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="11,0,4,0"/>
        <Setter Property="Background" Value="#FF22262C"/>
        <Setter Property="BorderBrush" Value="#FF383E47"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,8,6"/>
    </Style>

    <!-- ===== text box ===== -->
    <Style x:Key="Box" TargetType="TextBox">
        <Setter Property="Background" Value="#FF1F2329"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="#FF3A4048"/>
        <Setter Property="CaretBrush" Value="White"/>
        <Setter Property="SelectionBrush" Value="#FF2A79C8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="#FF5CB8FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- small number box (speed limit) -->
    <Style x:Key="Box.Small" TargetType="TextBox" BasedOn="{StaticResource Box}">
        <Setter Property="Background" Value="#FF15181C"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== tooltips + scrollbars ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF2A2F37"/>
        <Setter Property="Foreground" Value="#FFE6E9EE"/>
        <Setter Property="BorderBrush" Value="#FF3F4650"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="#FF454C56" Margin="2,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ThumbStyle}"/>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
