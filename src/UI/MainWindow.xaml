<Window x:Class="Choppy.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Choppy.UI"
        Title="Choppy" Width="576" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}" BorderBrush="{StaticResource B.WinBorder}" BorderThickness="1"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <!-- a disk, and a server for network places -->
        <Geometry x:Key="G.Drive">M2.5,1 H15.5 A1.5,1.5 0 0 1 17,2.5 V11.5 A1.5,1.5 0 0 1 15.5,13 H2.5 A1.5,1.5 0 0 1 1,11.5 V2.5 A1.5,1.5 0 0 1 2.5,1 Z M1,5 H17</Geometry>
        <Geometry x:Key="G.Server">M2.5,1 H13.5 A1.5,1.5 0 0 1 15,2.5 V15.5 A1.5,1.5 0 0 1 13.5,17 H2.5 A1.5,1.5 0 0 1 1,15.5 V2.5 A1.5,1.5 0 0 1 2.5,1 Z M1,6.3 H15 M1,11.7 H15 M3.6,3.7 H5.6 M3.6,9 H5.6 M3.6,14.3 H5.6</Geometry>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Dim" TargetType="Run">
            <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== title bar ===== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image x:Name="AppIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock x:Name="TitleText" Text="Choppy" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" Foreground="#FFE9ECF0"/>
                <TextBlock x:Name="TitleExtra" FontSize="13" Margin="8,1,0,0" VerticalAlignment="Center" Foreground="{StaticResource B.Faint}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Title}" Content="&#xE713;" FontSize="16" Height="46" ToolTip="Settings" Click="Settings_Click"/>
                <Button Style="{StaticResource Btn.TitleClose}" Content="&#xE8BB;" FontSize="12" Height="46" ToolTip="Close (a running copy keeps going in the tray)" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== content ===== -->
        <StackPanel Grid.Row="1" Margin="20,0,20,18">

            <!-- route, badge, bar, numbers -->
            <Grid x:Name="RouteGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="27"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource T.Cap}" Text="FROM" VerticalAlignment="Center"/>
                <Path x:Name="FromIcon" Grid.Column="1" Data="{StaticResource G.Drive}" Stroke="#FFAEB6C2" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="FromName" Grid.Column="2" Style="{StaticResource Head}" Text="-"/>
                <ui:PathText x:Name="FromPath" Grid.Column="3" Grid.ColumnSpan="3" Height="20" Margin="10,1,0,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="1" Style="{StaticResource T.Cap}" Text="TO" VerticalAlignment="Center"/>
                <Path x:Name="ToIcon" Grid.Row="1" Grid.Column="1" Data="{StaticResource G.Drive}" Stroke="#FFAEB6C2" StrokeThickness="1.3" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="ToName" Grid.Row="1" Grid.Column="2" Style="{StaticResource Head}" Text="-"/>
                <ui:PathText x:Name="ToPath" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Height="20" Margin="10,1,0,0" VerticalAlignment="Center"/>
                <!-- compact: speeds on their own row (right, where the bar ends), so the destination keeps the whole width -->
                <TextBlock x:Name="CompactSpeeds" Grid.Row="2" Grid.ColumnSpan="5" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,0,-6">
                    <Run x:Name="CNow" Text="" Foreground="{StaticResource B.NowSpeed}" FontWeight="SemiBold"/><Run x:Name="CAvgLabel" Text="" Foreground="{StaticResource B.Dim}" FontSize="12.5"/><Run x:Name="CAvg" Text="" Foreground="{StaticResource B.AvgSpeed}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- extended: badge + percent -->
                <Border x:Name="Badge" Grid.Row="3" Grid.ColumnSpan="4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0"
                        CornerRadius="15" Padding="12,4,14,5" Background="#FF132B44" BorderBrush="#FF245E9C" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BadgeDot" Width="7" Height="7" Fill="#FF3BA3FF" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        <TextBlock x:Name="BadgeMode" Text="Adaptive" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.AccentText}" Margin="8,0,0,0"/>
                        <TextBlock x:Name="BadgeDetail" Text="checking the drives" FontSize="13.5" Foreground="{StaticResource B.AccentText}" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PercentExt" Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="2" Text="0%" FontFamily="{StaticResource F.Display}" FontSize="30" FontWeight="Bold"
                           Foreground="#FFF5F7FA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,8,0,-4"/>

                <Grid x:Name="BarTrack" Grid.Row="4" Grid.ColumnSpan="5" Height="7" VerticalAlignment="Center" Margin="0,14,0,0">
                    <Border CornerRadius="3.5" Background="{StaticResource B.Track}"/>
                    <Border x:Name="Bar" CornerRadius="3.5" Background="{StaticResource B.Progress}" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <TextBlock x:Name="PercentCompact" Grid.Row="4" Grid.Column="5" Text="0%" FontFamily="{StaticResource F.Display}" FontSize="25" FontWeight="Bold"
                           Foreground="#FFF5F7FA" MinWidth="70" TextAlignment="Right" VerticalAlignment="Center" Margin="12,12,0,0"/>

                <!-- 24.8 GB of 35.8 GB · 2 of 6 files · Elapsed 37 min · Remaining 16 min -->
                <Grid x:Name="Stats" Grid.Row="5" Grid.ColumnSpan="5" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="14" VerticalAlignment="Center">
                        <Run x:Name="SizeDone" Text="" Foreground="{StaticResource B.SizeDone}" FontWeight="SemiBold"/><Run x:Name="SizeOf" Text="" Style="{StaticResource Dim}"/><Run x:Name="SizeTotal" Text="" Foreground="{StaticResource B.SizeTotal}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock x:Name="FilesText" Grid.Column="1" FontSize="14" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBlock Grid.Column="2" FontSize="14" VerticalAlignment="Center">
                        <Run x:Name="ElapsedLabel" Text="Elapsed " Style="{StaticResource Dim}"/><Run x:Name="ElapsedVal" Text="" Foreground="{StaticResource B.Time}" FontWeight="SemiBold"/><Run x:Name="RemainLabel" Text="" Style="{StaticResource Dim}"/><Run x:Name="RemainVal" Text="" Foreground="{StaticResource B.Remain}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- compact: what is happening right now -->
            <TextBlock x:Name="CompactLine" FontSize="14" Margin="0,12,0,0" TextTrimming="CharacterEllipsis">
                <Run x:Name="C2Label" Text="" Foreground="{StaticResource B.Dim}"/><Run x:Name="C2Name" Text="" Foreground="{StaticResource B.Text2}"/>
            </TextBlock>

            <!-- extended -->
            <StackPanel x:Name="ExtPanel">
                <!-- speed card -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,10,16,10">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource T.Cap}" Text="SPEED" VerticalAlignment="Center"/>
                            <Button x:Name="BtnUnit" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Margin="0,-4,-6,-4" Click="Unit_Click"
                                    ToolTip="Blue = speed right now, lavender = average of this copy (the time left uses the average). Click to switch Mbps / MB/s.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="AVG  " FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Dim}"/><Run x:Name="SpAvgNum" Text="–" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.AvgSpeed}"/><Run x:Name="SpAvgUnit" Text="" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.AvgSpeed}"/>
                                    </TextBlock>
                                    <TextBlock VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Run x:Name="SpNum" Text="–" FontFamily="{StaticResource F.Display}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource B.NowSpeed}"/><Run x:Name="SpUnit" Text="" FontFamily="{StaticResource F.Display}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource B.NowSpeed}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ui:SpeedGraph x:Name="Graph" Height="70" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- current file -->
                <StackPanel x:Name="CurrentSection" Margin="0,16,0,0">
                    <Grid>
                        <TextBlock x:Name="CurLabel" Style="{StaticResource T.Cap}" Text="CURRENT FILE" VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="14" VerticalAlignment="Center">
                            <Run x:Name="CurDone" Text="" Foreground="{StaticResource B.SizeDone}" FontWeight="SemiBold"/><Run x:Name="CurOf" Text="" Style="{StaticResource Dim}"/><Run x:Name="CurTotal" Text="" Foreground="{StaticResource B.SizeTotal}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock x:Name="CurName" Text="-" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    <Grid Height="4" Margin="0,9,0,0">
                        <Border CornerRadius="2" Background="{StaticResource B.Track}"/>
                        <Border x:Name="CurBar" CornerRadius="2" Background="#FF5AC8FA" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                </StackPanel>

                <!-- report (replaces the current file when the copy ends) -->
                <StackPanel x:Name="ReportSection" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="RepLabel" Style="{StaticResource T.Cap}" Text="DONE"/>
                    <TextBlock x:Name="RepTitle" FontSize="15.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <WrapPanel x:Name="RepRows" Margin="0,8,0,0"/>
                    <TextBlock x:Name="RepNote" FontSize="13" Foreground="{StaticResource B.Dim}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <!-- largest files -->
                <StackPanel x:Name="LargestSection" Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource T.Cap}" Text="LARGEST FILES"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Donut x:Name="DonutChart" Width="76" Height="76" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel x:Name="Legend" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- quick toggles: the same switches as in Settings, at hand while copying -->
                <StackPanel Margin="0,18,0,0">
                    <TextBlock Style="{StaticResource T.Cap}" Text="QUICK TOGGLES"/>
                    <WrapPanel Margin="0,9,0,-6">
                        <CheckBox x:Name="TgClose" Style="{StaticResource Quick}" Content="Close at completion" Checked="Quick_Changed" Unchecked="Quick_Changed"
                                  ToolTip="Close this window a few seconds after a copy finishes with no problems"/>
                        <CheckBox x:Name="TgVerify" Style="{StaticResource Quick}" Content="Verify files" Checked="Quick_Changed" Unchecked="Quick_Changed"
                                  ToolTip="Check every copied file against the original (xxHash64). A move then removes the original only after its copy matches."/>
                        <Border Style="{StaticResource QuickPill}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="TgLimit" Style="{StaticResource QuickDot}" Content="Speed limit" Checked="Quick_Changed" Unchecked="Quick_Changed" VerticalAlignment="Center"
                                          ToolTip="Leave room on the line for everything else"/>
                                <Rectangle Width="1" Height="18" Fill="#FF3A4048" Margin="10,0,8,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="LimitBox" Style="{StaticResource Box.Small}" VerticalAlignment="Center" MaxLength="6" TextChanged="LimitBox_Changed"/>
                                <TextBlock x:Name="LimitUnit" Text="MB/s" FontSize="13.5" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="7,0,8,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>

            <!-- actions -->
            <Grid Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel x:Name="RunButtons" Orientation="Horizontal">
                        <Button x:Name="BtnPause" Style="{StaticResource Btn.Primary}" Content="Pause" Height="36" MinWidth="84" Padding="18,0" Click="Pause_Click"/>
                        <Button x:Name="BtnSkip" Style="{StaticResource Btn}" Content="Skip" Height="36" MinWidth="0" Padding="18,0" Margin="8,0,0,0" Click="Skip_Click" ToolTip="Skip the current file"/>
                    </StackPanel>
                    <StackPanel x:Name="DoneButtons" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="BtnOpen" Style="{StaticResource Btn.Primary}" Content="Open folder" Height="36" Padding="16,0" Click="Open_Click"/>
                        <Button x:Name="BtnRetry" Style="{StaticResource Btn}" Content="Retry failed" Height="36" Padding="14,0" Margin="8,0,0,0" Click="Retry_Click"/>
                        <Button x:Name="BtnLog" Style="{StaticResource Btn}" Content="Log" Height="36" MinWidth="0" Padding="14,0" Margin="8,0,0,0" Click="Log_Click" ToolTip="Open the log of this copy"/>
                    </StackPanel>
                    <Button x:Name="BtnCancel" Style="{StaticResource Btn.Cancel}" Content="Cancel" Height="36" MinWidth="0" Padding="18,0" Margin="8,0,0,0" Click="Cancel_Click"/>
                    <Button x:Name="BtnQueue" Style="{StaticResource Btn}" Height="36" MinWidth="0" Padding="14,0" Margin="8,0,0,0" Click="Queue_Click" FontWeight="Normal">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="14" VerticalAlignment="Center"><Run Text="Queue   " Foreground="{StaticResource B.Dim}"/><Run x:Name="QueueCount" Text="0" Foreground="{StaticResource B.Text}" FontWeight="SemiBold"/></TextBlock>
                            <TextBlock x:Name="QueueChevron" Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="9" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="BtnView" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="View_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ViewText" Text="Extended" FontSize="14.5" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ViewChevron" Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="10" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="9,2,0,0"/>
                    </StackPanel>
                </Button>
                <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=BtnQueue}" Placement="Top" VerticalOffset="-6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#FF22262C" BorderBrush="#FF3A4048" BorderThickness="1" CornerRadius="8" Padding="6" Width="400">
                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="QueueList"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
