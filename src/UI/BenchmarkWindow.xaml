<Window x:Class="Choppy.UI.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choppy Benchmark" Width="860" MinWidth="800" SizeToContent="Height"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}" BorderBrush="{StaticResource B.WinBorder}" BorderThickness="1"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- the small buttons beside DRIVES: look again, + / − (only the button itself takes the click) -->
        <Style x:Key="Mini" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#FF22262C" BorderBrush="#FF383E47" BorderThickness="1" CornerRadius="5" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF2F353D"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF454C56"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF1E2227"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF5CB8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image x:Name="AppIcon" Width="20" Height="20"/>
                <TextBlock Text="Benchmark" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" Foreground="#FFE9ECF0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Btn.Title}" Content="&#xE921;" Height="46" ToolTip="Minimize" Click="Min_Click"/>
                <Button x:Name="MaxBtn" Style="{StaticResource Btn.Title}" Content="&#xE922;" Height="46" ToolTip="Maximize" Click="Max_Click"/>
                <Button Style="{StaticResource Btn.TitleClose}" Content="&#xE8BB;" FontSize="12" Height="46" ToolTip="Close" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="Body" Grid.Row="1" Margin="24,2,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Choppy VS Windows" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}"/>
                <TextBlock x:Name="Intro" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,6,0,0" LineHeight="20"
                           Text="Both copy the same test files on every drive of this PC - one big file and many small files, from the system drive to each other drive and back, and within each drive. They take turns, each one twice, and the source is never in memory. The test files go into a temporary folder on each drive and are removed at the end."/>

                <!-- the whole run in four numbers: average time saved, each one's average speed, the time saved -->
                <Border x:Name="TotalsCard" Style="{StaticResource Card}" Padding="0,12,0,13" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid x:Name="TotalsGrid"/>
                </Border>

                <!-- options -->
                <Grid x:Name="Options" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="ModeQuick" GroupName="mode" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="Quick" IsChecked="True" Checked="Mode_Changed"
                                     ToolTip="Big files of 1-2 GB and up to 1,000 small files"/>
                        <RadioButton x:Name="ModeThorough" GroupName="mode" Style="{StaticResource Seg}" Margin="0" Content="Thorough" Checked="Mode_Changed"
                                     ToolTip="Big files of 2-4 GB, up to 2,000 small files and a mixed folder"/>
                    </StackPanel>
                    <!-- runs each, for the mode chosen (kept for the next time) -->
                    <StackPanel x:Name="RunsPanel" Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" Background="Transparent">
                        <TextBlock Text="Runs" FontSize="14" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBox x:Name="RunsBox" Style="{StaticResource Box.Small}" Width="44" Height="30" MaxLength="2" TextChanged="Runs_Changed" LostKeyboardFocus="Runs_LostFocus"/>
                    </StackPanel>
                    <CheckBox x:Name="NetworkToggle" Grid.Column="2" Style="{StaticResource Toggle}" Margin="22,0,0,0" VerticalAlignment="Center" Checked="Network_Changed" Unchecked="Network_Changed"
                              ToolTip="Mapped network drives too: to and from the system drive, and within the share">
                        <TextBlock Text="Network drives" FontSize="14" Foreground="{StaticResource B.Text2}"/>
                    </CheckBox>
                    <TextBlock x:Name="Estimate" Grid.Column="3" FontSize="14" Foreground="{StaticResource B.Time}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- drives: the arrows look at them again (a drive plugged in), the − folds the list to one line, the + opens it again -->
            <StackPanel Grid.Row="1">
                <Grid x:Name="DrivesHead" Margin="0,13,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DRIVES" Style="{StaticResource T.Cap}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DrivesLine" Grid.Column="1" FontSize="12.5" Foreground="{StaticResource B.Dim}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="RescanBtn" Grid.Column="2" Style="{StaticResource Mini}" Content="&#xE72C;" Margin="0,0,6,0" VerticalAlignment="Center" Click="Rescan_Click"
                            ToolTip="Look at the drives again - a drive just plugged in, removed or mapped"/>
                    <Button x:Name="FoldBtn" Grid.Column="3" Style="{StaticResource Mini}" Content="&#xE738;" VerticalAlignment="Center" Click="Fold_Click"/>
                </Grid>
                <Border x:Name="DrivesCard" Style="{StaticResource Card}" Padding="14,6,14,6">
                    <StackPanel x:Name="DriveList"/>
                </Border>
            </StackPanel>

            <!-- progress, and a line under it: keep other work off the drives (where the report was saved, at the end) -->
            <StackPanel Grid.Row="2">
            <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="StepText" FontSize="14" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" Margin="0,0,280,0"/>
                    <!-- as in the copy window: Elapsed 2 min    Remaining 6 min -->
                    <TextBlock FontSize="14" HorizontalAlignment="Right">
                        <Run Text="Elapsed " Foreground="{StaticResource B.Dim}"/><Run x:Name="ElapsedVal" Foreground="{StaticResource B.Time}" FontWeight="SemiBold"/><Run x:Name="RemainLabel" Foreground="{StaticResource B.Dim}"/><Run x:Name="RemainVal" Foreground="{StaticResource B.Remain}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Grid>
                <Grid Height="7" Margin="0,10,0,0">
                    <Border CornerRadius="3.5" Background="{StaticResource B.Track}"/>
                    <Border x:Name="Bar" CornerRadius="3.5" Background="{StaticResource B.Progress}" HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </StackPanel>
            <TextBlock x:Name="Hint" Style="{StaticResource Sub}" FontSize="12.5" Foreground="{StaticResource B.Faint}" Margin="0,10,0,0"
                       Text="Keep other work off these drives while it runs: it measures them."/>
            </StackPanel>

            <!-- results: as tall as its rows, and no taller than the window leaves room for (then the list scrolls) -->
            <Grid x:Name="ResultsPanel" Grid.Row="3" Margin="0,18,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SummaryText" FontSize="21" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryNote" Grid.Row="1" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                <Border x:Name="ResultsCard" Grid.Row="2" Style="{StaticResource Card}" Padding="14,4,14,4" Margin="0,12,0,0">
                    <Grid x:Name="ResultsBox">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="ResultsHead" Margin="0,8,0,6"/>
                        <ScrollViewer x:Name="ResultsScroll" Grid.Row="1" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResultsList"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- buttons: Start; Abort while it runs (then Close); Run again at the end (and Close, after an abort) -->
            <StackPanel Grid.Row="4" Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FolderBtn" Style="{StaticResource Btn}" Content="Open folder" Height="38" Margin="0,0,10,0" Visibility="Collapsed" Click="Folder_Click"
                        ToolTip="Choppy's Logs folder: every Benchmark's page and .json"/>
                <Button x:Name="ReportBtn" Style="{StaticResource Btn}" Content="Open report" Height="38" Margin="0,0,10,0" Visibility="Collapsed" Click="Report_Click"/>
                <Button x:Name="AgainBtn" Style="{StaticResource Btn}" Content="Run again" Height="38" Margin="0,0,10,0" Visibility="Collapsed" Click="Again_Click"/>
                <Button x:Name="StartBtn" Style="{StaticResource Btn.Primary}" Content="Start" Height="38" Padding="26,0" MinWidth="104" Click="Start_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
