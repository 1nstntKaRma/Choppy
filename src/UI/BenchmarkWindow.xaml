<Window x:Class="Choppy.UI.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choppy benchmark" Width="860" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}" BorderBrush="{StaticResource B.WinBorder}" BorderThickness="1"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Dim}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image x:Name="AppIcon" Width="20" Height="20"/>
                <TextBlock Text="Benchmark" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" Foreground="#FFE9ECF0"/>
            </StackPanel>
            <Button Style="{StaticResource Btn.TitleClose}" Content="&#xE8BB;" FontSize="12" Height="46" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,2,24,20">
            <TextBlock Text="Choppy against Windows' own copy" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}"/>
            <TextBlock x:Name="Intro" Style="{StaticResource Sub}" FontSize="13.5" Margin="0,6,0,0" LineHeight="20"
                       Text="Both copy the same test files on every drive of this PC - one big file and many small files, from the system drive to each other drive and back, and within each drive. They take turns, each one twice, and the source is never in memory. The test files go into a temporary folder on each drive and are removed at the end."/>

            <!-- options -->
            <Grid x:Name="Options" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ModeQuick" GroupName="mode" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="Quick" IsChecked="True" Checked="Mode_Changed"
                                 ToolTip="Files of 0.5-1 GB and 1,000 small files, two runs each"/>
                    <RadioButton x:Name="ModeThorough" GroupName="mode" Style="{StaticResource Seg}" Margin="0" Content="Thorough" Checked="Mode_Changed"
                                 ToolTip="Files of 1-2 GB, 2,000 small files and a mixed folder, three runs each"/>
                </StackPanel>
                <CheckBox x:Name="NetworkToggle" Grid.Column="1" Style="{StaticResource Toggle}" Margin="22,0,0,0" VerticalAlignment="Center" Checked="Network_Changed" Unchecked="Network_Changed"
                          ToolTip="Mapped network drives too: to and from the system drive, and within the share">
                    <TextBlock Text="Network drives" FontSize="14" Foreground="{StaticResource B.Text2}"/>
                </CheckBox>
                <TextBlock x:Name="Estimate" Grid.Column="2" FontSize="14" Foreground="{StaticResource B.Time}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- drives -->
            <TextBlock Text="DRIVES" Style="{StaticResource T.Cap}" Margin="0,18,0,6"/>
            <Border Style="{StaticResource Card}" Padding="14,6,14,6">
                <StackPanel x:Name="DriveList"/>
            </Border>

            <!-- progress -->
            <StackPanel x:Name="ProgressPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="StepText" FontSize="14" Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" Margin="0,0,180,0"/>
                    <TextBlock x:Name="TimeText" FontSize="14" Foreground="{StaticResource B.Time}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Height="7" Margin="0,10,0,0">
                    <Border CornerRadius="3.5" Background="{StaticResource B.Track}"/>
                    <Border x:Name="Bar" CornerRadius="3.5" Background="{StaticResource B.Progress}" HorizontalAlignment="Left" Width="0"/>
                </Grid>
            </StackPanel>

            <!-- results -->
            <StackPanel x:Name="ResultsPanel" Margin="0,18,0,0" Visibility="Collapsed">
                <TextBlock x:Name="SummaryText" FontSize="21" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryNote" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                <Border Style="{StaticResource Card}" Padding="14,4,14,4" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid x:Name="ResultsHead" Margin="0,8,0,6"/>
                        <ScrollViewer x:Name="ResultsScroll" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ResultsList"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- buttons -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FootNote" Style="{StaticResource Sub}" FontSize="12.5" Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="0,0,16,0"
                           Text="Keep other work off these drives while it runs: it measures them."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Style="{StaticResource Btn}" Content="Copy results" Margin="0,0,10,0" Visibility="Collapsed" Click="Copy_Click"
                            ToolTip="A short table to paste in a chat or an issue"/>
                    <Button x:Name="FolderBtn" Style="{StaticResource Btn}" Content="Open folder" Margin="0,0,10,0" Visibility="Collapsed" Click="Folder_Click"
                            ToolTip="Choppy's Logs folder: every benchmark's page and .json"/>
                    <Button x:Name="ReportBtn" Style="{StaticResource Btn}" Content="Open report" Margin="0,0,10,0" Visibility="Collapsed" Click="Report_Click"/>
                    <Button x:Name="StartBtn" Style="{StaticResource Btn.Primary}" Content="Start" Height="38" Padding="26,0" Click="Start_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
