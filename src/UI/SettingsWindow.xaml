<Window x:Class="Choppy.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choppy settings" Width="540" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Window}" BorderBrush="{StaticResource B.WinBorder}" BorderThickness="1"
        FontFamily="{StaticResource F.Ui}" Foreground="{StaticResource B.Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Faint}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <GridLength x:Key="NameCol">200</GridLength>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource B.Sep}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,13,0,13"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <Image x:Name="AppIcon" Width="20" Height="20"/>
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center" Foreground="#FFE9ECF0"/>
            </StackPanel>
            <Button Style="{StaticResource Btn.TitleClose}" Content="&#xE8BB;" FontSize="12" Height="46" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        </Grid>

        <!-- one line per setting: name | what it does / its choices | switch (the choices and switches line up) -->
        <StackPanel Grid.Row="1" Margin="22,0,22,16">
            <!-- default file manager -->
            <Border x:Name="TakeoverRow" Style="{StaticResource Row}" Padding="0,4,0,12">
                <StackPanel>
                    <CheckBox x:Name="Takeover" Style="{StaticResource Toggle}" Checked="Takeover_Changed" Unchecked="Takeover_Changed"
                              ToolTip="Off: Windows' own copy stays the default; use right-click &quot;Paste with Choppy&quot;. Drag and drop always stays Windows' own copy.">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource NameCol}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Head}" Text="Default file manager" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Text="Ctrl+V in Explorer opens Choppy" VerticalAlignment="Center" Margin="0"/>
                        </Grid>
                    </CheckBox>
                    <TextBlock x:Name="UcNote" Style="{StaticResource Sub}" Foreground="{StaticResource B.Warn}" Margin="0,6,0,0" Visibility="Collapsed"
                               Text="Another copier that takes Ctrl+V is closed while this is on (off brings it back)."/>
                </StackPanel>
            </Border>

            <!-- conflicts -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Head}" Text="When a file already exists"/>
                    <WrapPanel Margin="0,10,0,-6">
                        <RadioButton x:Name="PAsk" GroupName="pol" Style="{StaticResource Seg}" Content="Ask me" Checked="Changed"/>
                        <RadioButton x:Name="PReplace" GroupName="pol" Style="{StaticResource Seg}" Content="Replace" Checked="Changed"/>
                        <RadioButton x:Name="PNewer" GroupName="pol" Style="{StaticResource Seg}" Content="Replace if newer" Checked="Changed"/>
                        <RadioButton x:Name="PSkip" GroupName="pol" Style="{StaticResource Seg}" Content="Skip" Checked="Changed"/>
                        <RadioButton x:Name="PBoth" GroupName="pol" Style="{StaticResource Seg}" Content="Keep both" Checked="Changed"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- unit -->
            <Border Style="{StaticResource Row}" Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameCol}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Head}" Text="Show speed in" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="UAuto" GroupName="unit" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="Auto" Checked="Changed"
                                     ToolTip="Picks by the copy: Mbps for a network share, MB/s for hard disks, SSDs and USB drives"/>
                        <RadioButton x:Name="UMbps" GroupName="unit" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="Mbps" Checked="Changed"
                                     ToolTip="Megabits per second - the unit internet and network speeds are given in"/>
                        <RadioButton x:Name="UMbs" GroupName="unit" Style="{StaticResource Seg}" Margin="0" Content="MB/s" Checked="Changed"
                                     ToolTip="Megabytes per second - the unit file sizes and disk speeds are given in"/>
                    </StackPanel>
                    <!-- in the switches' column: how Mbps and MB/s compare -->
                    <Grid Grid.Column="2" Width="44" VerticalAlignment="Center">
                        <Button x:Name="UnitHelpBtn" Width="28" Height="28" HorizontalAlignment="Center" Click="UnitHelp_Click" Cursor="Hand" ToolTip="Mbps and MB/s side by side">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="14" Background="#FF262B32" BorderBrush="#FF4A515C" BorderThickness="1">
                                        <TextBlock Text="?" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#FF15324F"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#FF2A79C8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <Popup x:Name="UnitHelp" PlacementTarget="{Binding ElementName=UnitHelpBtn}" Placement="Left" HorizontalOffset="-10" VerticalOffset="-14"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="UnitHelpCard" Background="#FF1E2228" BorderBrush="#FF3A414B" BorderThickness="1" CornerRadius="10" Padding="18,14,18,12" Margin="0,0,12,12" Width="350">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <!-- header (Mbps above its column, a long arrow, MB/s above its column), a line, the rows: built in code -->
                            <StackPanel x:Name="UnitRows"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- verify -->
            <Border Style="{StaticResource Row}">
                <CheckBox x:Name="Verify" Style="{StaticResource Toggle}" Checked="Changed" Unchecked="Changed"
                          ToolTip="Reads each copy back and compares it with the original. A move then removes the original only after its copy matches.">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource NameCol}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Head}" Text="Check every copy" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Text="xxHash64" VerticalAlignment="Center" Margin="0"/>
                    </Grid>
                </CheckBox>
            </Border>

            <!-- close at completion -->
            <Border Style="{StaticResource Row}" Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameCol}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Head}" Text="Close at completion" VerticalAlignment="Center"
                               ToolTip="Closes the copy window this many seconds after a copy finishes with no problems. A copy with problems stays open."/>
                    <TextBox x:Name="CloseValue" Grid.Column="1" Style="{StaticResource Box.Small}" Width="60" Height="30" MaxLength="3" TextChanged="CloseValue_Changed"
                             ToolTip="Whole seconds"/>
                    <TextBlock Grid.Column="2" Text="s" FontSize="14" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <CheckBox x:Name="AutoClose" Grid.Column="4" Style="{StaticResource Toggle}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                </Grid>
            </Border>

            <!-- speed limit -->
            <Border Style="{StaticResource Row}" Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameCol}"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Head}" Text="Speed limit" VerticalAlignment="Center" ToolTip="Leaves room on the line for everything else"/>
                    <TextBox x:Name="LimitValue" Grid.Column="1" Style="{StaticResource Box.Small}" Width="60" Height="30" MaxLength="6" TextChanged="LimitValue_Changed"/>
                    <TextBlock x:Name="LimitUnit" Grid.Column="2" Text="MB/s" FontSize="14" Foreground="{StaticResource B.Dim}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <CheckBox x:Name="Limit" Grid.Column="4" Style="{StaticResource Toggle}" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed"/>
                </Grid>
            </Border>

            <!-- benchmark -->
            <Border Style="{StaticResource Row}" Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource NameCol}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Head}" Text="Benchmark" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Sub}" Text="Choppy VS Windows" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Style="{StaticResource Btn}" Content="Run..." Height="30" Padding="14,0" MinWidth="0" Click="Benchmark_Click"
                            ToolTip="Choppy and Windows copy the same test files on every drive of this PC, then a report shows which one takes less time where"/>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource NameCol}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Btn.Link}" Click="Logs_Click" Margin="-6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Logs folder" FontSize="14" Foreground="{StaticResource B.Link}" Padding="0,0,0,2"/>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="-6,0,0,0">
                    <Button Style="{StaticResource Btn.Link}" Click="About_Click">
                        <TextBlock Text="About" FontSize="14" Foreground="{StaticResource B.Link}" Padding="0,0,0,2"/>
                    </Button>
                    <TextBlock x:Name="Version" FontSize="14" Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Primary}" Content="Done" Height="38" Padding="22,0" Click="Close_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
