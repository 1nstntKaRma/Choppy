<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>Choppy</RootNamespace>
    <AssemblyName>Choppy</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Choppy.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Choppy</Product>
    <Company>1nstntKaRma</Company>
    <Copyright>Copyright (c) 2026 1nstntKaRma</Copyright>
    <Description>Choppy - fast, clear file copy</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <!-- no local folder names inside the exe -->
    <PathMap>$(MSBuildProjectDirectory)=src</PathMap>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Choppy.ico" />
    <EmbeddedResource Include="..\LICENSE" LogicalName="LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
